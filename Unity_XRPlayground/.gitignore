*.app
*.exe
*.dll
*.so
*.dylib

# Addressables / StreamingAssets generated
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/

# Plastic SCM / Collaborate
*.private
*.private.meta
ignore.conf

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
